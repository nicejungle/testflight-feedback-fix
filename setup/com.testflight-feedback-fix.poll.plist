<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.testflight-feedback-fix.poll</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/gh</string>
        <string>workflow</string>
        <string>run</string>
        <string>Feedback Auto-Fix</string>
        <string>--ref</string>
        <string>main</string>
        <string>--repo</string>
        <string>OWNER/REPO</string>
    </array>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/testflight-feedback-fix.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/testflight-feedback-fix.log</string>
</dict>
</plist>
